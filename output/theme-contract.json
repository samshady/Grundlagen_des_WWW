{
  "theme_name": "unihalle",
  "slide_size": {"width": 1280, "height": 720, "ratio": "16:9"},
  "typography": {
    "families": ["Helvetica", "Arial", "system-ui"],
    "scale": [
      {"name": "display", "size": 34, "weight": 700, "line_height": 1.1},
      {"name": "heading_1", "size": 34, "weight": 700, "line_height": 1.1},
      {"name": "heading_2", "size": 24, "weight": 600, "line_height": 1.15},
      {"name": "heading_3", "size": 18, "weight": 500, "line_height": 1.2},
      {"name": "body", "size": 18, "weight": 400, "line_height": 1.4},
      {"name": "caption", "size": 12, "weight": 400, "line_height": 1.4},
      {"name": "small", "size": 10, "weight": 400, "line_height": 1.3}
    ],
    "min_size_px": 10,
    "contrast_ratio": {"body": 4.5, "large_text": 3.0}
  },
  "spacing": {
    "grid": 8,
    "margin_h": 50,
    "margin_v": 36,
    "card_padding": 20,
    "gap": 12
  },
  "colors": {
    "background": "#FFFFFF",
    "surface": "#F5F5F2",
    "surface_elevated": "#EFF5E5",
    "primary": "#9FBF47",
    "accent": "#295A97",
    "text_primary": "#282828",
    "text_secondary": "#6B7280",
    "text_decorative": "#928781"
  },
  "layouts": {
    "available": ["2-col", "center-single", "full-bleed"],
    "card_radius": 8,
    "card_shadow": "0 2px 8px rgba(0,0,0,0.08)"
  },
  "decoration_budget": "low",
  "chart_palette": ["#9FBF47", "#295A97", "#928781", "#F59E0B", "#EF4444"]
}
